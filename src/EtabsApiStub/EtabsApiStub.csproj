<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build-time stand-in for ETABS's API file, ETABSv1.dll: only the two types a plug-in may name (what the oldest version has), with the same
       assembly name, version and public key (the public half only, which anyone can read from ETABSv1.dll), so the
       plug-in binds to the real ETABSv1.dll inside ETABS. This file is never shipped and holds no code of CSI's. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>ETABSv1</AssemblyName>
    <RootNamespace>ETABSv1</RootNamespace>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>etabsv1-public.snk</AssemblyOriginatorKeyFile>
    <LangVersion>latest</LangVersion>
    <NoWarn>IDE1006;CS8981</NoWarn>
  </PropertyGroup>
</Project>
