<Project Sdk="Microsoft.NET.Sdk">
  <!-- The shared core: the model, the ETABS text file (.e2k) reader and writer, checks and quantities.
       No ETABS, no Windows: it builds and runs anywhere, and every other part of CSI ProMax uses it. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- A new model as ETABS 23 itself exports it (File > New Model, defaults): the settings every file needs. -->
    <EmbeddedResource Include="Seeds/etabs23.e2k" LogicalName="etabs23.e2k" />
    <EmbeddedResource Include="Seeds/forms-etabs.txt" LogicalName="forms-etabs.txt" />
    <EmbeddedResource Include="Seeds/overwrites-etabs.txt" LogicalName="overwrites-etabs.txt" />
    <EmbeddedResource Include="Seeds/overwrites-sap2000.txt" LogicalName="overwrites-sap2000.txt" />
    <EmbeddedResource Include="Seeds/wall-overwrites-etabs.txt" LogicalName="wall-overwrites-etabs.txt" />
    <EmbeddedResource Include="Seeds/forms-sap2000.txt" LogicalName="forms-sap2000.txt" />
  </ItemGroup>
</Project>
