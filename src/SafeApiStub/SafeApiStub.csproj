<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build-time stand-in for SAFE's API file, SAFEv1.dll: only the types a plug-in must name, under the same assembly
       name and version. It is signed with the public half of the key ETABSv1.dll and SAP2000v1.dll are signed with
       (token 453d728ef24c6f5e, read from those files), because a SAFE that runs on the .NET Framework (SAFE 20, 21)
       binds the plug-in to SAFEv1.dll only when name, version and key are all the same. That SAFEv1.dll carries this
       same key is taken from its sister files and not yet read from a SAFE 20 or 21: check.ps1 prints the real file's
       name, version and key on a PC that has one. SAFE on .NET 8 goes by the name alone. Never shipped. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>SAFEv1</AssemblyName>
    <RootNamespace>SAFEv1</RootNamespace>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <NoWarn>IDE1006;CS8981</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('safev1-public.snk')">
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>safev1-public.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
</Project>
