<Project Sdk="Microsoft.NET.Sdk">
  <!-- The assistant: Sketch ProMax's panel in a window of its own beside ETABS. It attaches to the running, licensed
       ETABS through ETABS's API and runs the chat on the Claude Code installed on this PC. The window is WPF, built in
       code (no XAML), so this builds on any machine; it runs on Windows only.
       It needs no ETABS file to build: ETABS is reached by name at run time. It needs only the .NET 8 that ETABS 23
       itself runs on, and is started without an .exe of its own: dotnet CsiProMax.dll, or from ETABS's Tools menu. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>CsiProMax</AssemblyName>
    <RootNamespace>CsiProMax.Assistant</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.4.35</Version>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <UseAppHost>false</UseAppHost>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RollForward>LatestMinor</RollForward>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="CsiProMax.ETABS" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- ACadSharp (MIT): reads and writes AutoCAD DWG and DXF files, for drawings attached to the chat and layouts given back. -->
    <PackageReference Include="ACadSharp" Version="1.0.6" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <!-- WebView2 (Microsoft, BSD-3): the Modeler's 3D view and the Viewer open in a CSI ProMax window of their own
         (Panel/Host/WebWindow.cs) instead of the PC's browser. It ships DLLs only (and WebView2Loader.dll under
         runtimes/); the page is drawn by the Edge WebView2 Runtime that Windows 10 and 11 already have. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <EmbeddedResource Include="../../assets/logo/csi-promax-64.png" LogicalName="CsiProMax.logo-64.png" />
    <EmbeddedResource Include="../../assets/logo/csi-promax.ico" LogicalName="CsiProMax.csi-promax.ico" />
    <EmbeddedResource Include="../../docs/guides/*.md" LogicalName="CsiProMax.guides.%(Filename).md" />
    <EmbeddedResource Include="../CsiProMax.Viewer/viewer.html" LogicalName="CsiProMax.viewer.html" />
    <EmbeddedResource Include="Panel/Chat/chat-prompts.json" LogicalName="CsiProMax.chat-prompts.json" />
    <!-- PDFium (BSD-3/Apache 2.0, Chrome's PDF engine) draws PDF pages so the chat can read drawings. Only the 64-bit
         Windows library is shipped, as CsiProMax.pdfium.dll next to the assistant. It is a .dll, not a program. -->
    <PackageReference Include="bblanchon.PDFium.Win32" Version="157.0.8086" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
    <None Include="Open the Modeler.cmd" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(Pkgbblanchon_PDFium_Win32)/runtimes/win-x64/native/pdfium.dll" Link="CsiProMax.pdfium.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <ProjectReference Include="../CsiProMax.Core/CsiProMax.Core.csproj" />
    <InternalsVisibleTo Include="CsiProMax.Tests" />
  </ItemGroup>
  <!--
    CDT SDK (Dar Structural Computational Design, private repository): the theme, control styles and message boxes every
    CSI ProMax window uses (Panel/UI/CdtTheme.cs), as in Sketch ProMax 0.35.121. Only its compiled DLLs live here, in
    lib/cdt-sdk/net8.0-windows/, built in Release from the commit named in cdt-sdk.ref (the same DLLs Sketch ProMax ships);
    its source never comes into this repository. CSI ProMax runs in a process of its own (the plug-in starts it), so the
    two DLLs simply sit beside CsiProMax.dll; no merge is needed.
  -->
  <PropertyGroup>
    <CdtSdkLib>$(MSBuildThisFileDirectory)..\..\lib\cdt-sdk\net8.0-windows\</CdtSdkLib>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="CDT.Core"><HintPath>$(CdtSdkLib)CDT.Core.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="CDT.Wpf"><HintPath>$(CdtSdkLib)CDT.Wpf.dll</HintPath><Private>true</Private></Reference>
    <!-- CDT.Wpf's one package (LaTeX rendering, MIT), at the version the SDK is built against. -->
    <PackageReference Include="WpfMath" Version="2.1.0" />
  </ItemGroup>
  <!-- Each source file with the hash of its text, inside CsiProMax.dll: the field test's "only what changed" mode
       (Field/FieldRetest.cs) tells from it which part's code changed since the version that part last passed on. -->
  <Target Name="CpmSourcePrints" BeforeTargets="BeforeBuild">
    <GetFileHash Files="@(Compile)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="CpmHashedSource" />
    </GetFileHash>
    <WriteLinesToFile File="$(IntermediateOutputPath)source-prints.txt" Lines="@(CpmHashedSource->'%(Identity)|%(FileHash)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)source-prints.txt" LogicalName="CsiProMax.source-prints.txt" />
    </ItemGroup>
  </Target>
  <Target Name="CpmCheckCdtSdk" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(CdtSdkLib)CDT.Wpf.dll')" Text="The CDT SDK DLLs are missing from lib\cdt-sdk\net8.0-windows." />
  </Target>

</Project>
