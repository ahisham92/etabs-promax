<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build-time stand-in for SAP2000's API file, SAP2000v1.dll: only the three types a plug-in must name, with the
       same assembly name, version and public key (the public half only, read from SAP2000 26's SAP2000v1.dll: token
       453d728ef24c6f5e, the same key as ETABSv1), so the plug-in binds to the real SAP2000v1.dll inside SAP2000 on
       .NET 8 and on .NET Framework alike. Never shipped, and holds no code of CSI's. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>SAP2000v1</AssemblyName>
    <RootNamespace>SAP2000v1</RootNamespace>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <NoWarn>IDE1006;CS8981</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('sap2000v1-public.snk')">
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>sap2000v1-public.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
</Project>
