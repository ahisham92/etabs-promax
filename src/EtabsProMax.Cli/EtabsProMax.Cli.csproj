<Project Sdk="Microsoft.NET.Sdk">
  <!-- epm: the command-line face of the core. Makes, converts, checks and measures models with no ETABS on the PC. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>epm</AssemblyName>
    <RootNamespace>EtabsProMax.Cli</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../EtabsProMax.Core/EtabsProMax.Core.csproj" />
  </ItemGroup>
</Project>
