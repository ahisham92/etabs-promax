<Project Sdk="Microsoft.NET.Sdk">
  <!-- The assistant: Sketch ProMax's panel in a window of its own beside ETABS. It attaches to the running, licensed
       ETABS through ETABS's API and runs the chat on the Claude Code installed on this PC. The window is WPF, built in
       code (no XAML), so this builds on any machine; it runs on Windows only.
       It needs no ETABS file to build: ETABS is reached by name at run time. It needs only the .NET 8 that ETABS 23
       itself runs on, and is started without an .exe of its own: dotnet EtabsProMax.dll, or from ETABS's Tools menu. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>EtabsProMax</AssemblyName>
    <RootNamespace>EtabsProMax.Assistant</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.3.0</Version>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <UseAppHost>false</UseAppHost>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RollForward>LatestMinor</RollForward>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="EtabsProMax.ETABS" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- ACadSharp (MIT): reads and writes AutoCAD DWG and DXF files, for drawings attached to the chat and layouts given back. -->
    <PackageReference Include="ACadSharp" Version="1.0.6" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <EmbeddedResource Include="../../assets/logo/etabs-promax-64.png" LogicalName="EtabsProMax.logo-64.png" />
    <EmbeddedResource Include="../../assets/logo/etabs-promax.ico" LogicalName="EtabsProMax.etabs-promax.ico" />
    <EmbeddedResource Include="../../docs/guides/*.md" LogicalName="EtabsProMax.guides.%(Filename).md" />
    <EmbeddedResource Include="../EtabsProMax.Viewer/viewer.html" LogicalName="EtabsProMax.viewer.html" />
    <EmbeddedResource Include="Panel/Chat/chat-prompts.json" LogicalName="EtabsProMax.chat-prompts.json" />
    <!-- PDFium (BSD-3/Apache 2.0, Chrome's PDF engine) draws PDF pages so the chat can read drawings. Only the 64-bit
         Windows library is shipped, as EtabsProMax.pdfium.dll next to the assistant. It is a .dll, not a program. -->
    <PackageReference Include="bblanchon.PDFium.Win32" Version="157.0.8086" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
    <None Include="$(Pkgbblanchon_PDFium_Win32)/runtimes/win-x64/native/pdfium.dll" Link="EtabsProMax.pdfium.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <ProjectReference Include="../EtabsProMax.Core/EtabsProMax.Core.csproj" />
    <InternalsVisibleTo Include="EtabsProMax.Tests" />
  </ItemGroup>
</Project>
