<Project Sdk="Microsoft.NET.Sdk">
  <!-- cpm: the command-line face of the core. Makes, converts, checks and measures models with no ETABS on the PC. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>cpm</AssemblyName>
    <RootNamespace>CsiProMax.Cli</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CsiProMax.Core/CsiProMax.Core.csproj" />
  </ItemGroup>
</Project>
