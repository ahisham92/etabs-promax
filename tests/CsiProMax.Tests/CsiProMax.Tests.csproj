<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks that run without ETABS. Run them with dotnet run in this folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/CsiProMax.Core/CsiProMax.Core.csproj" />
    <ProjectReference Include="../../src/CsiProMax.Assistant/CsiProMax.Assistant.csproj" />
    <ProjectReference Include="../../src/CsiProMax.Plugin/CsiProMax.Plugin.csproj" />
    <None Include="samples/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
